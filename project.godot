; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="srtest"
run/main_scene="uid://5fqryky1k7o6"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

global="*uid://psbels23dm04"
ToastParty="*res://addons/toastparty/toast-autoload.gd"
AppConfig="*res://addons/maaacks_input_remapping/base/scenes/autoloads/app_config.tscn"

[beautifier]

theme_script="res://addons/godot_beautifier/themes/Nana7mi/theme.gd"
default_settings={
"rendering/environment/defaults/default_clear_color": Color(0.3, 0.3, 0.3, 1)
}

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/3dmove/plugin.cfg", "res://addons/auto_expand_inspector/plugin.cfg", "res://addons/fancy_folder_icons/plugin.cfg", "res://addons/godot_beautifier/plugin.cfg", "res://addons/gridmap-better/plugin.cfg", "res://addons/inspector_tabs/plugin.cfg", "res://addons/kenyoni/plugin_reloader/plugin.cfg", "res://addons/maaacks_input_remapping/plugin.cfg", "res://addons/meshlib-exporter/plugin.cfg")

[gui]

common/auto_focus_strategy=1

