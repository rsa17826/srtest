[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[internationalization]

locale/translations=PackedStringArray("res://addons/maaacks_input_remapping/base/translations/menus_translations.en.translation", "res://addons/maaacks_input_remapping/base/translations/menus_translations.fr.translation")

[maaacks_input_remapping]

disable_plugin_dialogues=true

[physics]

3d/physics_engine="Jolt Physics"

[plugin]

fancy_folder_icons/openRules=false
fancy_folder_icons/rules={}
fancy_folder_icons/textureAppliesToNestedFolders=true

[rendering]

